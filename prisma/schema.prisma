datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model RoleGroup {
  id    String @id
  name  String
  roles Role[]
}

model Role {
  id          String      @id
  name        String
  description String      @db.Text
  groupId     String
  group       RoleGroup   @relation(fields: [groupId], references: [id])
  levels      RoleLevel[]
}

model RoleLevel {
  id            String           @id
  name          String
  description   String           @db.Text
  roleType      String?
  seniorityRank Int              @default(0)
  roleId        String
  role          Role             @relation(fields: [roleId], references: [id])
  skills        RoleLevelSkill[]
}

model Skill {
  id             String           @id
  name           String
  description    String           @db.Text
  awareness      String?          @db.Text
  working        String?          @db.Text
  practitioner   String?          @db.Text
  expert         String?          @db.Text
  isCustom       Boolean          @default(false)
  /// Previous slugs that still resolve to this skill after a framework rename.
  aliases        SkillAlias[]
  roleLevels     RoleLevelSkill[]
}

model RoleLevelSkill {
  roleLevelId   String
  skillId       String
  requiredLevel String
  roleLevel     RoleLevel @relation(fields: [roleLevelId], references: [id])
  skill         Skill     @relation(fields: [skillId], references: [id])

  @@id([roleLevelId, skillId])
}

model Standard {
  id           String         @id
  name         String
  jurisdiction String
  points       StandardPoint[]
}

model StandardPoint {
  id                String                  @id
  standardId        String
  number            Int
  title             String
  category          String?
  description       String                  @db.Text
  evidenceTypes     String[]
  phaseEmphasis     String[]
  compositionDriven Boolean                 @default(false)
  statutoryNote     String?                 @db.Text
  standard          Standard                @relation(fields: [standardId], references: [id])
  roleDeps          StandardPointRoleDep[]
  skillDeps         StandardPointSkillDep[]
  evidenceLinks     EvidenceLink[]
  questionPointRefs QuestionPointRef[]
}

model StandardPointRoleDep {
  id               String        @id @default(cuid())
  pointId          String
  roleId           String
  weight           Float         @default(1)
  minSeniorityRank Int           @default(0)
  point            StandardPoint @relation(fields: [pointId], references: [id])
}

model StandardPointSkillDep {
  id       String        @id @default(cuid())
  pointId  String
  skillId  String
  minLevel String
  weight   Float         @default(1)
  point    StandardPoint @relation(fields: [pointId], references: [id])
}

model FrameworkVersion {
  id           String      @id @default(cuid())
  source       String
  versionLabel String
  importedAt   DateTime    @default(now())
  notes        String?     @db.Text
  judgements   Judgement[]
}

model Organisation {
  id                String              @id @default(cuid())
  name              String
  /// Must match instance DEPLOYMENT_MODE (internal = Play A, client = Play B firewall).
  deploymentMode    String              @default("internal")
  users             User[]
  engagements       Engagement[]
  designEntities    DesignEntity[]
  designRelationships DesignRelationship[]
  designPeople      DesignPerson[]
  designAssignments DesignAssignment[]
  designComments    DesignComment[]
  designActivity    DesignActivity[]
  designSnapshots   DesignSnapshot[]
  designScenarios   DesignScenario[]
  designShareLinks  DesignShareLink[]
  roleArchetypes    RoleArchetype[]
  rigourSignals     RigourSignal[]
  orgInsightsCache  OrgInsightsCache?
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String?
  /// admin | member | assessor (read + comment, no edit)
  role               String              @default("member")
  orgId              String
  org                Organisation        @relation(fields: [orgId], references: [id])
  passwordHash       String?
  reviewAssignments  ReviewAssignment[]
  ownedEngagements   Engagement[]        @relation("EngagementOwner")
}

model Engagement {
  id                String        @id @default(cuid())
  name              String
  /// Title-block reference, e.g. NRW-DISC-01
  reference         String?
  /// Legacy engine key: gds | wales (kept for readiness analysis)
  standardId        String
  clientOrg         String?
  /// digital-service | capital-programme | hybrid
  sector            String?
  serviceName       String?
  serviceDescription String?      @db.Text
  /// discovery | alpha | beta | live | gate — filters applicable criteria
  phase             String        @default("discovery")
  /// Playbook maturity (doc 09 §10): practising | evidenced | assured | compounding
  /// Engagement attribute only — never enters fit score.
  maturityLevel     String        @default("practising")
  /// bid | mobilise | assure
  mode              String        @default("bid")
  /// Default report / UI content locale
  locale            String        @default("en")
  revision          String        @default("A")
  aiEnabled         Boolean       @default(true)
  ownerId           String?
  owner             User?         @relation("EngagementOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  /// Supplier or delivery partner label (Play B portfolio grouping)
  supplierTag       String?
  /// Framework lot or workstream (Play B portfolio grouping)
  lotTag            String?
  orgId             String
  org               Organisation  @relation(fields: [orgId], references: [id])
  /// live | scenario | snapshot — which org-design graph feeds this engagement
  designBinding     String        @default("live")
  designScenarioId  String?
  designSnapshotId  String?
  designSyncedAt    DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  requirements      Requirement[]
  people            Person[]
  tenders           Tender[]
  evidence          Evidence[]
  shareLinks        ShareLink[]
  judgements        Judgement[]
  reviewRequests    ReviewRequest[]
  catalogStandards    EngagementStandard[]
  assuranceEvidence   AssuranceEvidence[]
  criterionJudgements CriterionJudgement[]
  capabilityLinks     CapabilityLink[]
  evidenceOwners      CriterionEvidenceOwner[]
  indexSnapshots      IndexSnapshot[]
  fitScores           FitScore[]
  squadProposals      SquadProposal[]
  capabilityGapsFit   CapabilityGap[]
  rigourSignals       RigourSignal[]

  @@index([orgId])
  @@index([reference])
}

/// Versioned assurance catalogue (GDS / Wales / TCoP). Distinct from legacy Standard/StandardPoint.
model CatalogStandard {
  id          String                   @id @default(cuid())
  code        String                   @unique
  name        String
  publisher   String
  licence     String
  attribution String                   @db.Text
  sourceUrl   String?
  versions    CatalogStandardVersion[]

  @@map("catalog_standards")
}

model CatalogStandardVersion {
  id            String              @id @default(cuid())
  standardId    String
  version       String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  /// draft | current | superseded
  status        String              @default("current")
  changeNote    String?             @db.Text
  standard      CatalogStandard     @relation(fields: [standardId], references: [id], onDelete: Cascade)
  criteria      Criterion[]
  engagements   EngagementStandard[]

  @@unique([standardId, version])
  @@index([standardId])
  @@map("catalog_standard_versions")
}

model Criterion {
  id                String                 @id @default(cuid())
  standardVersionId String
  ref               String
  title             String
  statement         String                 @db.Text
  guidanceUrl       String?
  phases            String[]
  statutory         Boolean                @default(false)
  weight            Int                    @default(1)
  sortOrder         Int                    @default(0)
  standardVersion   CatalogStandardVersion @relation(fields: [standardVersionId], references: [id], onDelete: Cascade)
  translations           CriterionTranslation[]
  capabilityRequirements CapabilityRequirement[]
  evidenceLinks          EvidenceCriterion[]
  judgements             CriterionJudgement[]
  evidenceOwners         CriterionEvidenceOwner[]
  crosswalkMappings      CrosswalkMapping[]

  @@unique([standardVersionId, ref])
  @@index([standardVersionId])
  @@map("criteria")
}

model CriterionTranslation {
  id           String    @id @default(cuid())
  criterionId  String
  /// en | cy
  locale       String
  title        String
  statement    String    @db.Text
  /// human | machine
  reviewStatus String    @default("human")
  criterion    Criterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([criterionId, locale])
  @@index([criterionId])
  @@map("criterion_translations")
}

model EngagementStandard {
  engagementId      String
  standardVersionId String
  isPrimary         Boolean                @default(false)
  engagement        Engagement             @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  standardVersion   CatalogStandardVersion @relation(fields: [standardVersionId], references: [id])

  @@id([engagementId, standardVersionId])
  @@index([standardVersionId])
  @@map("engagement_standards")
}

/// Spec M4 — capability required by a criterion (global, versioned with criteria).
model CapabilityRequirement {
  id              String           @id @default(cuid())
  criterionId     String
  description     String           @db.Text
  roleArchetype   String?
  /// Basis points of an FTE (60 = 0.6)
  minFte          Int?
  skillTags       String[]
  phasePersistent Boolean          @default(false)
  criterion       Criterion        @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  links           CapabilityLink[]

  @@index([criterionId])
  @@map("capability_requirements")
}

model CapabilityLink {
  id                       String                @id @default(cuid())
  engagementId             String
  capabilityRequirementId  String
  entityId                 String
  accountabilityIndex      Int?
  /// satisfies | partially | informs
  strength                 String                @default("satisfies")
  note                     String?               @db.Text
  /// auto | human
  provenance               String                @default("human")
  confirmed                Boolean               @default(false)
  engagement               Engagement            @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  capabilityRequirement    CapabilityRequirement @relation(fields: [capabilityRequirementId], references: [id], onDelete: Cascade)

  @@index([engagementId])
  @@index([capabilityRequirementId])
  @@index([entityId])
  @@map("capability_links")
}

/// Spec evidence ledger — distinct from legacy Evidence (StandardPoint links).
model AssuranceEvidence {
  id               String             @id @default(cuid())
  engagementId     String
  title            String
  /// document | research | test | decision | code | metric | other
  kind             String
  uri              String?
  storageKey       String?
  ownerPersonId    String?
  producedAt       DateTime?
  expiresAt        DateTime?
  /// internal | client | publishable
  confidentiality  String             @default("client")
  /// manual | integration | import
  provenance       String             @default("manual")
  sourceSystem     String?
  externalId       String?
  createdByUserId  String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  engagement       Engagement         @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  criteria         EvidenceCriterion[]

  @@index([engagementId])
  @@index([engagementId, expiresAt])
  @@map("assurance_evidence")
}

model EvidenceCriterion {
  evidenceId  String
  criterionId String
  /// supports | partially | contextual
  strength    String            @default("supports")
  evidence    AssuranceEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  criterion   Criterion         @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@id([evidenceId, criterionId])
  @@map("evidence_criteria")
}

/// Spec criterion judgements — distinct from legacy Judgement (subject/status).
model CriterionJudgement {
  id                String    @id @default(cuid())
  engagementId      String
  criterionId       String
  /// met | at-risk | not-met | not-assessed
  verdict           String
  rationale         String    @db.Text
  /// human | ai | system
  proposedBy        String    @default("human")
  proposedByUserId  String?
  aiModel           String?
  aiPromptHash      String?
  confirmedByUserId String
  confirmedAt       DateTime  @default(now())
  supersededById    String?
  engagement        Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  criterion         Criterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@index([engagementId, criterionId, supersededById])
  @@map("criterion_judgements")
}

model CriterionEvidenceOwner {
  engagementId String
  criterionId  String
  personId     String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  criterion    Criterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@id([engagementId, criterionId])
  @@map("criterion_evidence_owners")
}

model IndexSnapshot {
  id           String     @id @default(cuid())
  engagementId String
  computedAt   DateTime   @default(now())
  value        Int?
  breakdown    Json
  cause        String?
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([engagementId, computedAt])
  @@map("index_snapshots")
}

model Requirement {
  id           String             @id @default(cuid())
  engagementId String
  title        String
  phase        String
  outcome      String             @db.Text
  channels     String[]
  sensitivity  String
  /// balanced | cost | speed | quality — drives requirement-flex reasoning
  flexPriority String             @default("balanced")
  engagement   Engagement         @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  roles        RequirementRole[]
  assignments  Assignment[]
  runs         AnalysisRun[]
  constraints  Constraint[]
  rigour       RigourAssessment[]
  outcomes     Outcome[]
}

model RequirementRole {
  id            String      @id @default(cuid())
  requirementId String
  roleLevelId   String
  weight        Float       @default(1)
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
}

model Person {
  id           String               @id @default(cuid())
  engagementId String
  displayName  String
  pseudonym    String?
  isVacancy    Boolean              @default(false)
  engagement   Engagement           @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  skills       PersonSkill[]
  assignments  Assignment[]
  availability PersonAvailability[]
}

model PersonSkill {
  id       String @id @default(cuid())
  personId String
  skillId  String
  level    String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model PersonAvailability {
  id             String    @id @default(cuid())
  personId       String
  availableFrom  DateTime?
  daysPerWeek    Float     @default(5)
  dayRate        Float?
  person         Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model Assignment {
  id            String      @id @default(cuid())
  requirementId String
  personId      String
  roleLevelId   String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  person        Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model Constraint {
  id                 String      @id @default(cuid())
  requirementId      String
  budgetCap          Float?
  startBy            DateTime?
  endBy              DateTime?
  internalRatePerDay Float?
  partnerRatePerDay  Float?
  requirement        Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
}

model AnalysisRun {
  id               String      @id @default(cuid())
  requirementId    String
  createdAt        DateTime    @default(now())
  overallReadiness Float
  readinessBand    String
  result           Json
  requirement      Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
}

model Evidence {
  id           String         @id @default(cuid())
  engagementId String
  title        String
  type         String
  description  String?        @db.Text
  url          String?
  strength     String
  createdAt    DateTime       @default(now())
  engagement   Engagement     @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  links        EvidenceLink[]
}

model EvidenceLink {
  id          String         @id @default(cuid())
  evidenceId  String
  pointId     String?
  questionId  String?
  roleLevelId String?
  evidence    Evidence       @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  point       StandardPoint? @relation(fields: [pointId], references: [id])
  question    ScoredQuestion? @relation(fields: [questionId], references: [id])
}

model RigourAssessment {
  id            String                 @id @default(cuid())
  requirementId String
  createdAt     DateTime               @default(now())
  assessedBy    String?
  requirement   Requirement            @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  dimensions    RigourDimensionScore[]
}

model RigourDimensionScore {
  id           String           @id @default(cuid())
  assessmentId String
  dimension    String
  score        Int
  evidenceNote String?          @db.Text
  assessment   RigourAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model Tender {
  id              String           @id @default(cuid())
  engagementId    String
  title           String
  buyer           String
  route           String?
  qualityWeight   Float
  priceWeight     Float
  scoringScaleMax Int              @default(5)
  engagement      Engagement       @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  questions       ScoredQuestion[]
}

model ScoredQuestion {
  id             String             @id @default(cuid())
  tenderId       String
  ref            String
  text           String             @db.Text
  weight         Float
  passThreshold  Int?
  isPassFail     Boolean            @default(false)
  category       String?
  tender         Tender             @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  roleDeps       QuestionRoleDep[]
  skillDeps      QuestionSkillDep[]
  pointRefs      QuestionPointRef[]
  drafts         QuestionDraft[]
  evidenceLinks  EvidenceLink[]
}

model QuestionRoleDep {
  id               String         @id @default(cuid())
  questionId       String
  roleId           String
  weight           Float          @default(1)
  minSeniorityRank Int            @default(0)
  question         ScoredQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuestionSkillDep {
  id         String         @id @default(cuid())
  questionId String
  skillId    String
  minLevel   String
  weight     Float          @default(1)
  question   ScoredQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuestionPointRef {
  id         String         @id @default(cuid())
  questionId String
  pointId    String
  question   ScoredQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  point      StandardPoint  @relation(fields: [pointId], references: [id])
}

model QuestionDraft {
  id         String         @id @default(cuid())
  questionId String
  body       String         @db.Text
  createdAt  DateTime       @default(now())
  approvedBy String?
  isScaffold Boolean        @default(false)
  question   ScoredQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Outcome {
  id            String      @id @default(cuid())
  requirementId String
  event         String
  result        String
  phase         String?
  recordedAt    DateTime    @default(now())
  notes         String?     @db.Text
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
}

model Judgement {
  id                  String            @id @default(cuid())
  subjectType         String
  subjectId           String
  engagementId        String
  status              String
  score               Float?
  frameworkVersionId  String?
  decidedBy           String?
  decidedAt           DateTime          @default(now())
  overrideReason      String?           @db.Text
  previousJudgementId String?
  engagement          Engagement        @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  frameworkVersion    FrameworkVersion? @relation(fields: [frameworkVersionId], references: [id])
}

model ReviewRequest {
  id           String             @id @default(cuid())
  engagementId String
  title        String
  subjectType  String
  subjectId    String
  status       String             @default("open")
  minApprovals Int                @default(2)
  createdById  String?
  createdAt    DateTime           @default(now())
  engagement   Engagement         @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  assignments  ReviewAssignment[]
}

model ReviewAssignment {
  id              String        @id @default(cuid())
  reviewRequestId String
  reviewerUserId  String
  stepOrder       Int           @default(0)
  status          String        @default("pending")
  comment         String?       @db.Text
  decidedAt       DateTime?
  reviewRequest   ReviewRequest @relation(fields: [reviewRequestId], references: [id], onDelete: Cascade)
  reviewer        User          @relation(fields: [reviewerUserId], references: [id])
}

model ShareLink {
  id           String     @id @default(cuid())
  engagementId String
  token        String     @unique
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
}

/// Live org-design node (circle | role | product). Scenarios/snapshots hold JSON copies.
model DesignEntity {
  id               String       @id @default(cuid())
  orgId            String
  org              Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name             String
  type             String
  purpose          String?      @db.Text
  domain           String?      @db.Text
  accountabilities Json         @default("[]")
  policies         Json         @default("[]")
  parentId         String?
  /// Optional bridge to DDaT Role catalogue
  ddatRoleId       String?
  /// Optional bridge to DDaT RoleLevel for sync-to-team
  ddatRoleLevelId  String?
  metadata         Json         @default("{}")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([orgId])
}

model DesignRelationship {
  id        String       @id @default(cuid())
  orgId     String
  org       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sourceId  String
  targetId  String
  type      String
  metadata  Json         @default("{}")
  createdAt DateTime     @default(now())

  @@index([orgId])
}

model DesignPerson {
  id        String       @id @default(cuid())
  orgId     String
  org       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  fte       Int          @default(100)
  skills    Json         @default("[]")
  notes     String?      @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([orgId])
}

model DesignAssignment {
  id         String       @id @default(cuid())
  orgId      String
  org        Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  personId   String
  entityId   String
  allocation Int          @default(100)
  createdAt  DateTime     @default(now())

  @@index([orgId])
}

/// Cached org-design insights (doc 08 §2.4). Recomputed on write; served on read by inputsHash.
model OrgInsightsCache {
  id          String       @id @default(cuid())
  orgId       String       @unique
  org         Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  inputsHash  String
  insights    Json
  computedAt  DateTime     @default(now())

  @@map("org_insights_cache")
}

model DesignComment {
  id        String       @id @default(cuid())
  orgId     String
  org       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  entityId  String
  author    String       @default("Guest")
  content   String       @db.Text
  createdAt DateTime     @default(now())

  @@index([orgId])
  @@index([entityId])
}

model DesignActivity {
  id        String       @id @default(cuid())
  orgId     String
  org       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  action    String
  target    String?
  details   Json         @default("{}")
  createdAt DateTime     @default(now())

  @@index([orgId])
}

model DesignSnapshot {
  id          String       @id @default(cuid())
  orgId       String
  org         Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?      @db.Text
  data        Json
  createdAt   DateTime     @default(now())

  @@index([orgId])
}

model DesignScenario {
  id          String       @id @default(cuid())
  orgId       String
  org         Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?      @db.Text
  /// { entities, relationships } — optional people/assignments for engagement forks
  data        Json
  engagementId String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([orgId])
}

model DesignShareLink {
  id         String       @id @default(cuid())
  orgId      String
  org        Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  token      String       @unique
  name       String?
  snapshotId String?
  createdAt  DateTime     @default(now())

  @@index([orgId])
}

/// Gate / construction frameworks for crosswalk (distinct from FrameworkVersion drift table).
model AssuranceFramework {
  id          String                   @id @default(cuid())
  code        String                   @unique
  name        String
  publisher   String
  version     String?
  licence     String?
  attribution String?                  @db.Text
  items       AssuranceFrameworkItem[]

  @@map("assurance_frameworks")
}

model AssuranceFrameworkItem {
  id          String             @id @default(cuid())
  frameworkId String
  ref         String
  title       String
  question    String?            @db.Text
  parentRef   String?
  sortOrder   Int                @default(0)
  /// Optional pack grouping, e.g. gate-3, riba-3
  packRef     String?
  framework   AssuranceFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  mappings    CrosswalkMapping[]

  @@unique([frameworkId, ref])
  @@index([frameworkId])
  @@index([packRef])
  @@map("assurance_framework_items")
}

model CrosswalkMapping {
  id              String                 @id @default(cuid())
  criterionId     String
  frameworkItemId String
  /// satisfies | partially | informs
  relation        String
  note            String?                @db.Text
  authoredBy      String
  reviewedBy      String
  reviewedAt      DateTime
  criterion       Criterion              @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  frameworkItem   AssuranceFrameworkItem @relation(fields: [frameworkItemId], references: [id], onDelete: Cascade)

  @@unique([criterionId, frameworkItemId])
  @@index([criterionId])
  @@index([frameworkItemId])
  @@map("crosswalk_mappings")
}

// --- Team Fit (spec 07 / migration 007) ---

/// Named template of roles a delivery context requires.
model RoleArchetype {
  id           String          @id @default(cuid())
  orgId        String
  name         String
  slug         String
  /// gds_discovery | gds_alpha | gds_beta_live | capital_integration | assurance_review | bilingual_service | custom
  context      String
  description  String?         @db.Text
  /// Standard catalogue refs this archetype supports, e.g. gds-service-standard@2019.1
  standardRefs Json            @default("[]")
  version      Int             @default(1)
  isSystem     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  archivedAt   DateTime?
  org          Organisation    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  roles        ArchetypeRole[]
  proposals    SquadProposal[]

  @@unique([orgId, slug, version])
  @@index([orgId])
  @@map("role_archetypes")
}

model ArchetypeRole {
  id             String            @id @default(cuid())
  archetypeId    String
  ddatRoleId     String
  displayTitle   String
  /// awareness | working | practitioner | expert
  minLevel       String
  fteRequired    Float
  /// core | supporting | optional
  criticality    String            @default("core")
  sortOrder      Int
  /// Array<{ skillId, requiredLevel, weight }>
  requiredSkills Json              @default("[]")
  archetype      RoleArchetype     @relation(fields: [archetypeId], references: [id], onDelete: Cascade)
  fitScores      FitScore[]
  assignments    SquadAssignment[]
  gaps           CapabilityGap[]

  @@index([archetypeId])
  @@map("archetype_roles")
}

model RigourSignal {
  id                String       @id @default(cuid())
  orgId             String
  /// DesignPerson id (Organise people)
  personId          String
  engagementId      String?
  /// sustained_assignment | capacity_discipline | nfr_planning | spike_discipline | assurance_participation | handover_quality
  type              String
  /// derived | asserted
  provenance        String
  /// -1.0 .. 1.0
  value             Float
  evidenceId        String?
  note              String?      @db.Text
  observedAt        DateTime
  confirmedByUserId String?
  createdAt         DateTime     @default(now())
  org               Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  engagement        Engagement?  @relation(fields: [engagementId], references: [id], onDelete: SetNull)

  @@index([personId])
  @@index([orgId])
  @@index([engagementId])
  @@map("rigour_signals")
}

model FitScore {
  id                String         @id @default(cuid())
  engagementId      String
  archetypeRoleId   String
  personId          String
  skillScore        Float
  rigourMultiplier  Float
  compositeScore    Float
  /// strong | viable | stretch | gap
  band              String
  breakdown         Json
  scoringVersion    String
  /// Government Digital and Data Profession Capability Framework pin at compute time.
  frameworkVersion  String          @default("unversioned")
  inputsHash        String
  computedAt        DateTime       @default(now())
  engagement        Engagement     @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  archetypeRole     ArchetypeRole  @relation(fields: [archetypeRoleId], references: [id], onDelete: Cascade)
  assignments       SquadAssignment[]

  @@unique([engagementId, archetypeRoleId, personId])
  @@index([engagementId, archetypeRoleId, compositeScore])
  @@map("fit_scores")
}

model SquadProposal {
  id                String            @id @default(cuid())
  engagementId      String
  archetypeId       String
  /// draft | confirmed | superseded
  status            String            @default("draft")
  confirmedByUserId String?
  confirmedAt       DateTime?
  createdAt         DateTime          @default(now())
  engagement        Engagement        @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  archetype         RoleArchetype     @relation(fields: [archetypeId], references: [id])
  assignments       SquadAssignment[]

  @@index([engagementId])
  @@map("squad_proposals")
}

model SquadAssignment {
  id              String        @id @default(cuid())
  proposalId      String
  archetypeRoleId String
  personId        String
  fteAllocated    Float
  fitScoreId      String?
  rationale       String?       @db.Text
  overrideReason  String?       @db.Text
  proposal        SquadProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  archetypeRole   ArchetypeRole @relation(fields: [archetypeRoleId], references: [id])
  fitScore        FitScore?     @relation(fields: [fitScoreId], references: [id])

  @@index([proposalId])
  @@map("squad_assignments")
}

model CapabilityGap {
  id                 String        @id @default(cuid())
  engagementId       String
  archetypeRoleId    String
  /// skills_gap | rigour_gap | capacity_gap
  kind               String
  severity           Int
  bestAvailableScore Float?
  /// upskill | second | recruit | rescope
  recommendation     String
  narrative          String        @db.Text
  standardRefs       Json          @default("[]")
  computedAt         DateTime      @default(now())
  engagement         Engagement    @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  archetypeRole      ArchetypeRole @relation(fields: [archetypeRoleId], references: [id])

  @@index([engagementId])
  @@map("capability_gaps")
}

/// Old capability-framework slugs that must still resolve after a rename or merge.
model SkillAlias {
  id        String    @id @default(cuid())
  alias     String    @unique
  skillId   String
  note      String?
  retiredAt DateTime?
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
  @@map("skill_aliases")
}

/// Pin for the Government Digital and Data Profession Capability Framework ingest.
model CapabilityFrameworkPin {
  id           String   @id @default(cuid())
  versionLabel String
  sourceDate   DateTime
  rolesCsvHash String?
  skillsCsvHash String?
  sourceFiles  Json     @default("[]")
  notes        String?  @db.Text
  importedAt   DateTime @default(now())

  @@index([importedAt])
  @@map("capability_framework_pins")
}
